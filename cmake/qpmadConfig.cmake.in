set (@PROJECT_NAME@_VERSION @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@)

@PACKAGE_INIT@

# try to be provide both qpmad::qpmad and legacy qpmad_INCLUDE_DIRS
set (@CMAKE_PROJECT_NAME@_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include/")
include("${PACKAGE_PREFIX_DIR}/share/@PROJECT_NAME@/cmake/@PROJECT_NAME@Targets.cmake")

include(CMakeFindDependencyMacro)
find_dependency(Eigen3)

get_target_property(QPMAD_EIGEN_INCLUDES Eigen3::Eigen INTERFACE_INCLUDE_DIRECTORIES)

foreach(dir ${QPMAD_EIGEN_INCLUDES})
    list(APPEND @CMAKE_PROJECT_NAME@_INCLUDE_DIRS "${dir}")
endforeach()
